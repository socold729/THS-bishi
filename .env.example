# Server only. Never prefix credentials with NEXT_PUBLIC_.
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn
DATA_REQUEST_TIMEOUT_MS=12000
# OpenAI Responses API, server-side only. Restart the server after changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
# Optional future cloud adapter. Current preferences live in this browser.
DATABASE_URL=
# Server-side iFinD MCP, independently authenticated. Never expose to browser.
IFIND_ENABLED=false
IFIND_MCP_KEY=
IFIND_TIMEOUT_MS=20000
